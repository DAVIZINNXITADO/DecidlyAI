VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Configure this as a Supabase Edge Function secret for decidly-translate.
# Never expose the key in frontend code or commit it to git.
DEEPL_API_KEY=

# Public configuration only. Keep provider secrets server-side.
# NewClick website ID from the publisher dashboard. The native slot uses the VIP creative if no valid banner loads.
VITE_NEWCLICK_WEBSITE_ID=13525

# Optional public checkout configuration. Do not put secret keys here.
VITE_PAYMENT_PROVIDER=
VITE_PAYMENT_CHECKOUT_URL=

# Server-side / Supabase Edge Function secrets only.
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
